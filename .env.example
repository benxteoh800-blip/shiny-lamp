# ────────────────────────────────────────────────────────────────────────────
# Malaysia Motorcycle Launch Bot – Environment Variables
# Copy this file to .env and fill in your values.
# ────────────────────────────────────────────────────────────────────────────

# ── Telegram ─────────────────────────────────────────────────────────────────
# Get a bot token from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your-telegram-bot-token-here

# Your personal chat ID or group/channel chat ID.
# Send a message to @userinfobot on Telegram to find your chat ID.
TELEGRAM_CHAT_ID=your-telegram-chat-id-here

# ── OpenAI ────────────────────────────────────────────────────────────────────
# API key from https://platform.openai.com/api-keys
OPENAI_API_KEY=your-openai-api-key-here

# Model to use for analysis (default: gpt-4o-mini — fast and cheap)
# Options: gpt-4o, gpt-4-turbo, gpt-3.5-turbo, gpt-4o-mini
OPENAI_MODEL=gpt-4o-mini

# ── Bot Behaviour ─────────────────────────────────────────────────────────────
# Number of articles to fetch per news source (default: 5)
ARTICLES_PER_SOURCE=5

# Daily run time in 24-hour format (server local time).
# TIP: If your server is UTC, add 8 hours for Malaysia Time (e.g. 08:00 MYT = 00:00 UTC)
SCHEDULE_TIME=08:00

# Run the bot immediately when it starts? (1 = yes, 0 = no)
RUN_ON_START=1
